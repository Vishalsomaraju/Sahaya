# ==============================================================================
# SAHAYA Healthcare Platform — Backend Server Environment Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to `server/.env`:
#    cp .env.example .env
# 2. Populate your Neon database credentials and generate secure keys.
# 3. DO NOT commit `.env` containing sensitive credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK & APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Port for Express HTTP server
PORT=5000

# Runtime environment (development | production | test)
NODE_ENV=development

# Allowed CORS origins for frontend web client (comma-separated)
CLIENT_ORIGIN=https://sahaya-health.vercel.app,http://localhost:5173

# Render Deployment Metadata
RENDER_SERVICE_ID=srv-db6h9ojl550s73asvrj0
RENDER_SERVICE_URL=https://sahaya-ag6r.onrender.com

# Internal logging verbosity (debug | info | warn | error)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. NEON CLOUD POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Pooled Connection String (Used by Prisma Client & runtime API queries)
# Format: postgresql://<user>:<password>@<ep-pooler>.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://<neon_user>:<neon_password>@<neon_endpoint>-pooler.c-13.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct / Unpooled Connection String (Used for schema migrations & CLI commands)
DATABASE_URL_UNPOOLED="postgresql://<neon_user>:<neon_password>@<neon_endpoint>.c-13.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon Project Metadata
NEON_PROJECT_ID=your-neon-project-id
NEON_PROJECT_NAME=Sahaya
NEON_BRANCH=production
NEON_ORG_ID=your-neon-org-id
NEON_HOST=<neon_endpoint>-pooler.c-13.us-east-1.aws.neon.tech
NEON_DATABASE=neondb
NEON_USER=neondb_owner

# ------------------------------------------------------------------------------
# 3. CRYPTOGRAPHY, AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# 256-bit secret for signing JWT tokens.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-256-bit-jwt-secret-hex

# Access token validity window (e.g. 24h, 7d, 30m)
JWT_EXPIRES_IN=24h

# 256-bit secret for session management & cookies
SESSION_SECRET=your-256-bit-session-secret-hex

# 256-bit key for field-level encryption / health record integrity hashing
DATA_ENCRYPTION_KEY=your-256-bit-encryption-key-hex

# Bcrypt salt cost rounds for password hashing
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 4. IOT WEARABLE TELEMETRY & FIELD INGESTION
# ------------------------------------------------------------------------------
# Default fallback patient UUID when device streams telemetry unauthenticated
WEARABLE_DEFAULT_PATIENT=demo-patient

# Allows public ingestion for POST /api/patient/vitals without Authorization header (true for IoT demo / false for strict auth)
AUTH_DISABLED=true

# Telemetry heartbeat window in seconds
WEARABLE_POLL_INTERVAL_SEC=6

# ------------------------------------------------------------------------------
# 5. CLINICAL DECISION ENGINE & AI ASSISTANT (OPTIONAL)
# ------------------------------------------------------------------------------
# Anthropic Claude API Key for narrative triage enrichment & patient summary cards
# (Optional: the deterministic, protocol-grounded safety triage engine runs safely without it)
ANTHROPIC_API_KEY=

# Neon AI Gateway / LLM Proxy base URL (optional fallback)
AI_GATEWAY_URL=https://gateway.ai.neon.tech/v1
