# ==============================================================================
# SAHAYA Production Frontend Client Environment (.env.production)
# Target: Vercel (https://sahaya-health.vercel.app)
# Backend Target: Render (https://sahaya-ag6r.onrender.com)
# ==============================================================================

# Backend API Endpoint (Inlined by Vite during production build)
VITE_API_URL=https://sahaya-ag6r.onrender.com
VITE_RENDER_API_URL=https://sahaya-ag6r.onrender.com
VITE_VERCEL_APP_URL=https://sahaya-health.vercel.app

# Application Metadata & Flags
VITE_APP_NAME="SAHAYA Rural Healthcare Triage Assistant"
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production
VITE_ENABLE_WEARABLE_POLLING=true
VITE_POLL_INTERVAL_MS=6000
VITE_DEFAULT_PATIENT_ID=demo-patient
VITE_ENABLE_MOCK_FALLBACK=true
VITE_CLINICAL_DISCLAIMER_ENABLED=true
VITE_DEFAULT_LOCALE=en-IN
