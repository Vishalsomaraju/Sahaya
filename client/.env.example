# ==============================================================================
# SAHAYA Healthcare Platform — Frontend Client Environment Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to `client/.env`:
#    cp .env.example .env
#
# 2. Hybrid Run Support:
#    - Local frontend + Local backend:
#      Set VITE_API_URL=http://localhost:5000
#
#    - Local frontend + Deployed Render backend:
#      Set VITE_API_URL=https://sahaya-ag6r.onrender.com
#
#    - Vercel Deployment (https://sahaya-health.vercel.app):
#      Add VITE_API_URL=https://sahaya-ag6r.onrender.com to Vercel Environment Variables.
#      (Note: Even if omitted, client/src/lib/api.ts automatically auto-detects
#       the cloud domain and connects to https://sahaya-ag6r.onrender.com)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API CONNECTIVITY
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000

# Locked Production Endpoints
VITE_RENDER_API_URL=https://sahaya-ag6r.onrender.com
VITE_VERCEL_APP_URL=https://sahaya-health.vercel.app

# ------------------------------------------------------------------------------
# 2. APPLICATION IDENTITY & BRANDING
# ------------------------------------------------------------------------------
VITE_APP_NAME="SAHAYA Rural Healthcare Triage Assistant"
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# 3. CLINICAL TRIAGE & WEARABLE TELEMETRY SETTINGS
# ------------------------------------------------------------------------------
VITE_ENABLE_WEARABLE_POLLING=true
VITE_POLL_INTERVAL_MS=6000
VITE_DEFAULT_PATIENT_ID=demo-patient
VITE_ENABLE_MOCK_FALLBACK=true
VITE_CLINICAL_DISCLAIMER_ENABLED=true
VITE_DEFAULT_LOCALE=en-IN
